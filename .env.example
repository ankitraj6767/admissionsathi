##############################################
# ADMISSION SATHI - Environment variables
# Copy to `.env.local` and fill in real values.
# NEVER prefix a server secret with NEXT_PUBLIC_.
##############################################

# ---------- Core ----------
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Admission Sathi"

# ---------- Database (server only) ----------
# MongoDB Atlas connection string
MONGODB_URI="mongodb+srv://user:password@cluster.mongodb.net/admission-sathi?retryWrites=true&w=majority"
MONGODB_DB_NAME=admission-sathi

# ---------- Auth.js ----------
# openssl rand -base64 32
AUTH_SECRET="replace-with-a-32-byte-random-string"
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ---------- Media storage ----------
# Provider: cloudinary | s3 | local
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# ---------- Email ----------
# Provider: console | resend | smtp
EMAIL_PROVIDER=console
EMAIL_FROM="Admission Sathi <no-reply@admissionsathi.org>"
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ---------- WhatsApp ----------
# Provider: console | meta | gupshup
WHATSAPP_PROVIDER=console
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# ---------- SMS ----------
# Provider: console | twilio | msg91
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER_ID=

# ---------- AI assistant ----------
# Provider: mock | openai | anthropic | bedrock
AI_PROVIDER=mock
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---------- Analytics ----------
# Provider list (comma separated): first-party,ga,gtm,meta
NEXT_PUBLIC_ANALYTICS_PROVIDERS=first-party
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ---------- Caching / rate limiting (optional) ----------
# Leave empty to use the in-memory fallback (single instance only)
REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------- Error tracking (optional) ----------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ---------- Seed accounts (development only) ----------
SEED_SUPER_ADMIN_EMAIL=admin@admissionsathi.org
SEED_SUPER_ADMIN_PASSWORD=Admin@12345
SEED_STUDENT_EMAIL=student@admissionsathi.org
SEED_STUDENT_PASSWORD=Student@12345

# ---------- Cron ----------
CRON_SECRET="replace-with-a-random-string"
