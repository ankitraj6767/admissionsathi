{
  "name": "admission-sathi",
  "version": "1.0.0",
  "private": true,
  "description": "Admission Sathi - Your Career, Our Mission. Education discovery, counselling, predictors, loans and admission management platform.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "assets:colleges": "tsx scripts/generate-college-assets.ts",
    "db:indexes": "tsx --conditions=react-server src/db/migrations/run-indexes.ts",
    "predb:seed": "npm run assets:colleges",
    "db:seed": "tsx --conditions=react-server src/db/seeds/run-seed.ts",
    "db:seed:additive": "tsx --conditions=react-server scripts/seed-additive.ts",
    "predb:seed:fresh": "npm run assets:colleges",
    "db:seed:fresh": "tsx --conditions=react-server src/db/seeds/run-seed.ts --fresh",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:all": "npm run test:unit && npm run test:integration",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "analyze": "ANALYZE=true next build"
  },
  "dependencies": {
    "@auth/mongodb-adapter": "3.11.3",
    "@fortawesome/free-brands-svg-icons": "7.3.1",
    "@hookform/resolvers": "5.4.1",
    "@radix-ui/react-accordion": "1.2.11",
    "@radix-ui/react-checkbox": "1.3.2",
    "@radix-ui/react-dialog": "1.1.14",
    "@radix-ui/react-dropdown-menu": "2.1.15",
    "@radix-ui/react-label": "2.1.7",
    "@radix-ui/react-popover": "1.1.14",
    "@radix-ui/react-select": "2.2.5",
    "@radix-ui/react-separator": "1.1.7",
    "@radix-ui/react-slot": "1.2.3",
    "@radix-ui/react-switch": "1.2.5",
    "@radix-ui/react-tabs": "1.1.12",
    "@radix-ui/react-tooltip": "1.2.7",
    "@tanstack/react-table": "8.21.3",
    "bcryptjs": "3.0.3",
    "class-variance-authority": "0.7.1",
    "cloudinary": "2.10.0",
    "clsx": "2.1.1",
    "dotenv": "17.2.3",
    "framer-motion": "12.42.2",
    "lucide-react": "1.26.0",
    "mongodb": "6.21.0",
    "mongoose": "8.24.1",
    "next": "16.2.11",
    "next-auth": "5.0.0-beta.32",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.83.0",
    "recharts": "3.10.0",
    "sanitize-html": "2.17.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/bcryptjs": "3.0.0",
    "@types/node": "22.18.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "@types/sanitize-html": "2.16.0",
    "eslint": "9.39.1",
    "eslint-config-next": "16.2.11",
    "jsdom": "26.1.0",
    "mongodb-memory-server": "^10.1.4",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}